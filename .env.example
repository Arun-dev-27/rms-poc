PORT=3000

MSSQL_HOST=localhost
MSSQL_PORT=14330
MSSQL_USER=sa
MSSQL_PASSWORD="Rms_Strong#2026"
MSSQL_DATABASE=MMS

REDIS_HOST=localhost
REDIS_PORT=6395

# Redis write/read batch size (pipeline chunk)
REDIS_BATCH_SIZE=5000
# App-level snapshot schedule (cron) and retention
SNAPSHOT_CRON="*/15 * * * *"
SNAPSHOT_DIR=./snapshots
SNAPSHOT_KEEP=5

# Stage source (READ-ONLY) - used only to import dbo.Mumin_Mast into the docker MSSQL
SOURCE_MSSQL_HOST=
SOURCE_MSSQL_PORT=1433
SOURCE_MSSQL_USER=
SOURCE_MSSQL_PASSWORD=
SOURCE_MSSQL_DATABASE=MMS

# Reconcile Redis with MSSQL change tracking (catches writes made outside this API)
RECONCILE_CRON="*/1 * * * *"
